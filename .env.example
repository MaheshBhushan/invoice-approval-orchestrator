CAMUNDA_VERSION=8.9.16
POSTGRES_VERSION=17-alpine
POSTGRES_PORT=5432
POSTGRES_DB=invoice_workflow
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=invoice_dev

# Optional: LLM schema extraction for scanned PDF intake; the rule extractor runs when unset.
ANTHROPIC_API_KEY=
OCR_EXTRACTION_MODEL=claude-haiku-5-5
OCR_CONFIDENCE_THRESHOLD=0.80
# Optional: create Azure DevOps Boards work items for sub-0.80-confidence invoices
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# Set a random token to enable the Power Automate approval adapter.
APPROVAL_API_TOKEN=
